# Fonte dos dados dos candidatos:
#   tse      → API ao vivo do DivulgaCandContas, com fallback automático para o snapshot (padrão)
#   snapshot → só o snapshot local em src/data/tse-snapshot.json (modo offline / mock)
CANDIDATE_SOURCE=tse

# Opcional: base da API do TSE (ex.: um espelho/proxy se o TSE bloquear a região do servidor)
# TSE_BASE_URL=https://divulgacandcontas.tse.jus.br/divulga/rest
